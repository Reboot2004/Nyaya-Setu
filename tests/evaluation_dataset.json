    ],
    "evaluation_metrics": {
        "entity_extraction": {
            "description": "Measure accuracy of extracted facts",
            "metric": "Exact match on aggressor, date, location fields"
        },
        "section_retrieval": {
            "description": "Measure statute retrieval recall",
            "metric": "% of expected sections found in top-5 results"
        },
        "complaint_filtering": {
            "description": "Measure filtering accuracy",
            "metric": "TP / (TP + FP + FN) for actionability decision"
        }
    }
